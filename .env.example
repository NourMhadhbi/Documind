# Copier ce fichier en ".env" puis remplir les vraies valeurs.
# Ne JAMAIS committer ".env" (il est dans .gitignore).
# Chaque variable ci-dessous DOIT correspondre à un champ de config.py :
# pydantic-settings refuse les variables inconnues (tests/test_config.py le vérifie).

# ---- DagsHub / MLflow ----
DAGSHUB_TOKEN=
MLFLOW_TRACKING_URI=https://dagshub.com/ton_username/documind.mlflow
MLFLOW_TRACKING_USERNAME=ton_username
MLFLOW_TRACKING_PASSWORD=

# ---- Génération : "anthropic" (cloud) ou "ollama" (local) ----
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
LLM_MODEL_NAME=claude-sonnet-5

# Ollama (local, ex: conteneur docker-compose.ollama.yml)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
