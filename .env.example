# Copier ce fichier en ".env" et remplir avec tes vraies valeurs.
# Ne JAMAIS committer le fichier ".env" réel (il est dans .gitignore).

# ==== DagsHub (DVC + MLflow) ====
DAGSHUB_USERNAME=ton_username
DAGSHUB_TOKEN=ton_token_dagshub

# URL du serveur MLflow hébergé par DagsHub pour ce repo
MLFLOW_TRACKING_URI=https://dagshub.com/ton_username/documind.mlflow
MLFLOW_TRACKING_USERNAME=ton_username
MLFLOW_TRACKING_PASSWORD=ton_token_dagshub

# ==== LLM (choisir le fournisseur utilisé) ====
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ==== Index vectoriel ====
CHROMA_DB_PATH=data/index

# ==== API ====
API_HOST=0.0.0.0
API_PORT=8000
